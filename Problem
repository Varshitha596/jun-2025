'''class Solution:
  def topoSort(self,V,edges):
    adj=[[]for _ in range(V)]
    for u,v in edges:
      adj[u].append(v)
    visited =[False]*V
    stack=[]
    def dfs(node):
      visited[node]=True
      for nei in adj[node]:
        if not visited[nei]:
          dfs(nei)
      stack.append(node)
    for i in range(V):
      if not visited[i]:
        dfs(i)
